# ========================================================
# LeakOSINT API Configuration
# Documentation: https://leakosintapi.com/
# ========================================================

# Your personal LeakOSINT API token (obtained from Telegram bot via /api command)
LEAKOSINT_API_TOKEN=

# Default search limit (100 - 10000, default is 100)
LEAKOSINT_DEFAULT_LIMIT=100

# Default response language ('en', 'ru')
LEAKOSINT_DEFAULT_LANG=en

# Optional: Telegram bot token (if running the telegram bot from telegram_bot.py)
TELEGRAM_BOT_TOKEN=
